{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "academe/omnipay-authorizenetapi": " ~3.0",
        "anandsiddharth/laravel-paytm-wallet": "^2.0",
        "cartalyst/stripe-laravel": "^16.0",
        "firebase/php-jwt": "^6.2",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.5",
        "laravel/framework": "^11.4",
        "laravel/passport": "^12.0",
        "laravel/serializable-closure": "^1.0",
        "laravel/socialite": "^5.11",
        "laravel/tinker": "^2.9",
        "league/omnipay": "^3.2",
        "mollie/laravel-mollie": "^3.0",
        "omnipay/authorizenet": "3.x@dev",
        "omnipay/braintree": "~4.0@dev",
        "omnipay/paypal": "dev-test-ghactions",
        "omnipay/sagepay": "^4.0",
        "orangehill/iseed": "^3.0",
        "razorpay/razorpay": "^2.8",
        "stripe/stripe-php": "^7.85",
        "sudiptpa/omnipay-openpay": "^3.0",
        "twilio/sdk": "^7.0",
        "vectorcoder/laravel-installer": "dev-master",
        "nesbot/carbon": "^3.2.4"

    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.4",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "kundol/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "kundol/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
